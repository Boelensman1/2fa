{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["./**/*", "./.wxt/wxt.d.ts", "postcss.config.mjs"],
  // repeats the excludes inherited from .wxt/tsconfig.json, because setting
  // `exclude` here replaces the inherited list rather than extending it
  "exclude": ["**/node_modules", ".output", "dev-output", "artifacts"]
}
